#!/usr/bin/env python3
"""Opt-in MCP elicitation/dialog/hook qualification on owned disposable cloud resources.

An SDK FastMCP 1.30.0 child calls ctx.elicit / ctx.elicit_url; the worker relays
each as an ``elicitation`` control_request. Form and URL accept/decline/cancel are
answered through ``answer_elicitation`` and proven by the child's own tool result
and ledger. Timeout (child gives up and sends MCP notifications/cancelled) and
abort (host interrupts the turn while the elicitation is open) record what the
worker and child actually did.
Also records hook registration and the session's MCP server names (for the
Chrome forced-ask premise). ``--capture-web`` opens and closes one owned dev CDP
tab on the owned session and scans the loaded web bundle, without any input.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import runpy
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from claude_rc import RemoteControlClient

helpers = runpy.run_path(str(Path(__file__).with_name("claude-rc-permission-smoke")))
collect, tool_results = helpers["collect"], helpers["tool_results"]
mcp_smoke = runpy.run_path(str(Path(__file__).with_name("claude-rc-mcp-smoke")))
cleanup_resources, fixture_install_prompt = mcp_smoke["cleanup_resources"], mcp_smoke["fixture_install_prompt"]
warm_seconds, fixture_server = mcp_smoke["warm_seconds"], mcp_smoke["fixture_server"]

WEB_PATTERNS = ["can_use_tool", "request_user_dialog", "supportedDialogKinds", "dialog_kind",
                "requested_schema", "elicitation_id", "mcp_server_name", "hook_callback", "askForTools"]
SCAN = """async (pats) => {
  const urls = [...new Set(performance.getEntriesByType('resource').map(e => e.name)
      .filter(n => /\\.js(\\?|$)/.test(n)))];
  const counts = Object.fromEntries(pats.map(p => [p, 0]));
  for (const u of urls) {
    let t; try { t = await (await fetch(u)).text(); } catch (e) { continue; }
    for (const p of pats) counts[p] += t.split(p).length - 1;
  }
  return {scripts: urls.length, counts};
}"""
ANSWERS = (("accept", {"name": "Ada", "count": 3}), ("decline", None), ("cancel", None))


def child_result(block):
    content = block["content"]
    texts = [content] if isinstance(content, str) else [b.get("text", "") for b in content]
    return json.loads("".join(texts))


def capture_web(url):
    from playwright.sync_api import sync_playwright
    with sync_playwright() as playwright:
        browser = playwright.chromium.connect_over_cdp("http://127.0.0.1:9222")
        page = browser.contexts[0].new_page()
        try:
            page.goto(url, wait_until="domcontentloaded", timeout=90000)
            page.get_by_role("textbox").wait_for(timeout=60000)
            page.wait_for_timeout(5000)
            return {"url": page.url, **page.evaluate(SCAN, WEB_PATTERNS)}
        finally:
            page.close()
            browser.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--capture-web", action="store_true")
    args = parser.parse_args()
    proof = {"run": "elicit-" + uuid.uuid4().hex[:10], "checks": [], "cleanup": [], "complete": False}
    sid = eid = None

    def save():
        args.output.write_text(json.dumps(proof, indent=2) + "\n")

    def record(name, **details):
        proof["checks"].append({"name": name, **details})
        save()
        print(json.dumps(proof["checks"][-1]), flush=True)

    with RemoteControlClient(direct=True, timeout=25) as client:
        try:
            eid = client.create_cloud_environment(proof["run"], cwd="/mnt/user-data/working",
                description="Disposable generated-only elicitation qualification")["environment_id"]
            proof["environment_id"] = eid
            save()
            sid = client.create_session(eid, title=proof["run"], model="claude-haiku-5-5",
                                        permission_mode="default")["id"]
            proof["session_id"] = sid
            save()
            init = client.initialize(sid, timeout=60)
            record("worker", version=init.get("claude_code_version"),
                   pending_user_dialog_requests=len(init.get("pending_user_dialog_requests") or []))
            reply = client.request_control(sid, "initialize", timeout=60,
                hooks={"PreToolUse": [{"matcher": "Bash", "hookCallbackIds": [proof["run"]], "timeout": 10}]})
            record("hook_registration", hooks_applied=reply.get("hooks_applied"),
                   cli_contract="false = a joining client's hooks were ignored; the stdin owner configured the session")
            assert reply.get("hooks_applied") is False
            if args.capture_web:
                from claude_rc.lifecycle import session_web_url
                record("web_bundle", **capture_web(session_web_url(sid)))

            def reject(request):
                client.deny_permission(sid, request, "Unexpected fixture operation; stop.", interrupt=True)
                raise AssertionError(f"unexpected {request.kind}")

            source = (Path(__file__).resolve().parent.parent / "tests/fixtures/mcp_elicitation.py").read_bytes()
            path = "/mnt/user-data/working/" + proof["run"] + ".py"
            events, _ = collect(client, sid, fixture_install_prompt(source, path), reject)
            digest = hashlib.sha256(source).hexdigest()
            results = tool_results(events, "Bash")
            assert len(results) == 1 and digest in results[0]["content"]
            record("fixture_bytes", sha256=digest, tool_use_id=results[0]["tool_use_id"],
                   uv_warm_seconds=warm_seconds(results[0]["content"]))
            server = proof["run"]
            tool = f"mcp__{server}__ask"
            added = client.set_worker_mcp_servers(sid, {server: fixture_server(path)}, confirm=True, timeout=90)
            record("mcp_set_servers", added=added.get("added"), errors=added.get("errors"))
            assert server in added.get("added", []) and not added.get("errors"), json.dumps(added)[:300]
            rows = client.mcp_status(sid, live_reply=True, timeout=40)
            names = [row.get("name") or "" for row in rows]
            record("mcp_servers", server_count=len(names), own_fixture_present=server in names,
                   chrome_server_present="claude-in-chrome" in names)
            ledger = []

            def watch(name, answer):
                seen, allowed = [], []

                def respond(request):
                    if request.kind == "permission" and request.tool_name == name and not allowed:
                        allowed.append(request.request_id)
                        client.allow_once(sid, request)
                        return
                    if request.kind != "elicitation" or request.request.get("mcp_server_name") != server:
                        reject(request)
                    seen.append({k: request.request.get(k) for k in
                                 ("mcp_server_name", "message", "mode", "url", "elicitation_id", "requested_schema")})
                    seen[-1]["request_id"] = request.request_id
                    answer(request)
                return seen, respond

            def ledger_rows():
                return [json.loads(line) for line in
                        client.read_file(sid, path[:-3] + ".elicit")["contents"].splitlines()]

            def cancels(events, request_id):
                return [e.payload for e in events if e.payload.get("type") == "control_cancel_request"
                        and e.payload.get("request_id") == request_id]

            for action, content in ANSWERS:
                marker = f"ELICIT_{action.upper()}"
                seen, respond = watch(tool, lambda r, a=action, c=content: client.answer_elicitation(sid, r, a, c))
                events, _ = collect(client, sid,
                    f"Call {tool} exactly once with marker {marker}. No other tools. Then reply DONE.", respond)
                replies = tool_results(events, tool)
                assert len(seen) == 1 and seen[0]["message"] == f"Generated elicitation {marker}"
                assert len(replies) == 1 and not replies[0].get("is_error")
                expected = {"marker": marker, "action": action, "content": content}
                assert child_result(replies[0]) == expected
                ledger.append(expected)
                assert ledger_rows() == ledger
                record("elicitation_continuation", action=action, request=seen[0],
                       child_tool_result=replies[0], ledger_rows=len(ledger), ledger_exact=True)
            url_tool = f"mcp__{server}__ask_url"
            for action in ("accept", "decline", "cancel"):
                marker = f"URL_{action.upper()}"
                seen, respond = watch(url_tool, lambda r, a=action: client.answer_elicitation(sid, r, a))
                events, _ = collect(client, sid,
                    f"Call {url_tool} exactly once with marker {marker}. No other tools. Then reply DONE.", respond)
                replies = tool_results(events, url_tool)
                expected = {"marker": marker, "mode": "url", "action": action}
                assert len(seen) == 1 and seen[0]["mode"] == "url" and seen[0]["elicitation_id"] == marker
                assert seen[0]["url"] == f"https://example.com/claude-rc/{marker}" and not seen[0]["requested_schema"]
                assert len(replies) == 1 and not replies[0].get("is_error") and child_result(replies[0]) == expected
                ledger.append(expected)
                assert ledger_rows() == ledger
                record("url_elicitation_continuation", action=action, request=seen[0],
                       answer={"action": action}, child_tool_result=replies[0], ledger_exact=True)
            timeout_tool = f"mcp__{server}__ask_timeout"
            seen, respond = watch(timeout_tool, lambda r: None)
            events, _ = collect(client, sid, f"Call {timeout_tool} exactly once with marker ELICIT_TIMEOUT and "
                                "seconds 15. No other tools. Then reply DONE.", respond, timeout=180)
            replies = tool_results(events, timeout_tool)
            expected = {"marker": "ELICIT_TIMEOUT", "action": "timeout", "code": 408}
            assert len(seen) == 1 and len(replies) == 1 and child_result(replies[0]) == expected
            ledger.append(expected)
            assert ledger_rows() == ledger
            still_pending = [r.request_id for r in client.pending_requests(sid, initialize=True) if r.request_id == seen[0]["request_id"]]
            assert not still_pending and cancels(events, seen[0]["request_id"])
            record("elicitation_timeout", request=seen[0], host_answered=False, child_tool_result=replies[0],
                   worker_cancel_events=cancels(events, seen[0]["request_id"]), still_pending=still_pending,
                   ledger_exact=True)
            seen, respond = watch(tool, lambda r: client.interrupt(sid))
            events, _ = collect(client, sid, f"Call {tool} exactly once with marker ELICIT_ABORT. No other tools. "
                                "Then reply DONE.", respond, allow_error=True)
            assert len(seen) == 1
            rows = ledger_rows()
            assert rows[:len(ledger)] == ledger
            tail = rows[len(ledger):]
            assert len(tail) == 1 and tail[0]["marker"] == "ELICIT_ABORT", tail
            ledger.extend(tail)
            still_pending = [r.request_id for r in client.pending_requests(sid, initialize=True) if r.request_id == seen[0]["request_id"]]
            turn_end = next(e for e in reversed(events) if e.source == "worker" and e.is_turn_end)
            record("elicitation_abort", request=seen[0], host_action="interrupt", child_ledger_row=tail[0],
                   child_tool_results=tool_results(events, tool), worker_cancel_events=cancels(events, seen[0]["request_id"]),
                   still_pending=still_pending, turn_end={"subtype": turn_end.subtype,
                                                         "is_error": turn_end.payload.get("is_error")})
            assert not still_pending and cancels(events, seen[0]["request_id"])
            assert tail[0]["action"] == "tool_cancelled"
            assert turn_end.payload.get("is_error") and turn_end.subtype == "error_during_execution"
            proof["complete"] = True
        except Exception as error:
            record("aborted", error_class=type(error).__name__, error=str(error)[:300])
            raise
        finally:
            cleanup_resources(client, sid, eid, proof, save)


if __name__ == "__main__":
    main()
